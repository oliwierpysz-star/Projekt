---
// Scene inside the hero's pinned stage: slides in from the right, then a light travels the route
// and unlocks each step; the call to action waits at the end of the road.
const stops = [
  { t: 'Dzwonisz', d: 'Mówisz, co to za auto i czego potrzebuje. Wycena jest darmowa.' },
  { t: 'Odbieramy auto', d: 'Przyjeżdżamy po kluczyki pod Twój dom albo pracę.' },
  { t: 'Robimy swoje', d: 'Detailing w pełnym zakresie, bez Twojego udziału.' },
  { t: 'Oddajemy lśniące', d: 'W to samo miejsce, o umówionej porze.' },
];
const wa = `https://wa.me/48881265265?text=${encodeURIComponent('Dzień dobry, proszę o wycenę detailingu.')}`;
---
<div class="route" data-route>
  <div class="route__in wrap">
    <div class="route__head">
      <h2 class="display h2" id="route-title">Ty nigdzie<br />nie <em>jedziesz.</em></h2>
      <p class="lead">Detailing door to door na terenie całego Śląska i Małopolski. Cała robota dzieje się po naszej stronie.</p>
    </div>

    <div class="route__map">
      <svg class="route__svg" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">
        <path class="route__base" d="M10 120 C 170 40, 270 170, 400 110 S 650 40, 770 105 S 920 160, 990 90" data-route-path />
      </svg>
      <svg class="route__svg route__svg--draw" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true" data-route-draw>
        <path class="route__draw" d="M10 120 C 170 40, 270 170, 400 110 S 650 40, 770 105 S 920 160, 990 90" />
      </svg>
      <span class="route__light" aria-hidden="true" data-route-light></span>
      <ol class="route__stops">
        {stops.map((s, i) => (
          <li class="route__stop" data-stop data-t={[0.02, 0.35, 0.66, 0.98][i]}>
            <span class="route__pin" aria-hidden="true"></span>
            <div class="route__text">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="route__cta" data-route-cta>
      <p class="route__ask">Gotowe? Zacznij od darmowej wyceny.</p>
      <div class="route__acts">
        <a class="route__tel phone" href="tel:+48881265265">881 265 265</a>
        <a class="act act--accent" href={wa} target="_blank" rel="noopener">Napisz na WhatsApp <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</div>

<style>
  .route {
    position: absolute; inset: 0; z-index: 5;
    background:
      radial-gradient(70% 60% at 85% 20%, rgba(91, 140, 255, 0.08), transparent 70%),
      linear-gradient(180deg, var(--bg-2), var(--bg));
    transform: translateX(100%);
    box-shadow: -40px 0 80px rgba(0, 0, 0, 0.6);
  }
  .route__in { height: 100%; display: grid; grid-template-rows: auto 1fr auto; padding-top: clamp(5.5rem, 13vh, 9rem); padding-bottom: clamp(2rem, 7vh, 5rem); }
  .route__head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: end; }

  .route__map { position: relative; margin: 2rem 0; min-height: 15rem; }
  .route__svg { position: absolute; left: 0; right: 0; top: 50%; width: 100%; height: 34%; transform: translateY(-50%); overflow: visible; }
  .route__svg path { fill: none; vector-effect: non-scaling-stroke; }
  .route__base { stroke: rgba(233, 237, 243, 0.28); stroke-width: 1.5; stroke-dasharray: 3 8; }
  .route__draw { stroke: var(--accent); stroke-width: 2.5; }
  .route__svg--draw { clip-path: inset(-30px 100% -30px 0); }
  .route__light {
    position: absolute; left: 0; top: 0; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 0 5px rgba(91, 140, 255, 0.35), 0 0 30px 8px rgba(91, 140, 255, 0.6);
    opacity: 0;
  }
  .route__stops { list-style: none; margin: 0; padding: 0; }
  .route__stop { position: absolute; left: 0; top: 0; width: 0; height: 0; }
  .route__pin {
    position: absolute; left: -9px; top: -9px; width: 18px; height: 18px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--dim);
    transition: border-color 0.4s, background 0.4s, box-shadow 0.4s;
  }
  .route__stop.is-on .route__pin { border-color: var(--accent); background: var(--accent); box-shadow: 0 0 0 7px rgba(91, 140, 255, 0.16); }
  .route__text { position: absolute; width: 15rem; left: -1rem; top: 2.2rem; opacity: 0.18; transform: translateY(10px); transition: opacity 0.5s, transform 0.6s var(--ease); }
  .route__stop:nth-child(even) .route__text { top: auto; bottom: 2.2rem; }
  .route__stop:last-child .route__text { left: auto; right: -1rem; text-align: right; }
  .route__stop.is-on .route__text { opacity: 1; transform: none; }
  .route__text h3 { font-stretch: 120%; font-weight: 800; text-transform: uppercase; font-size: clamp(1.05rem, 1.4vw, 1.4rem); }
  .route__text p { margin-top: 0.4rem; color: var(--mute); font-size: 0.95rem; }

  .route__cta { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem 2.5rem; opacity: 0; transform: translateY(16px); transition: opacity 0.6s, transform 0.7s var(--ease); }
  .route__cta.is-on { opacity: 1; transform: none; }
  .route__ask { color: var(--mute); font-size: clamp(1rem, 1.3vw, 1.2rem); }
  .route__acts { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1rem 2.4rem; }
  .route__tel { font-size: clamp(1.8rem, 3.2vw, 3rem); font-stretch: 118%; font-weight: 750; }

  @media (prefers-reduced-motion: reduce) {
    .route { position: relative; transform: none; box-shadow: none; }
    .route__text, .route__cta { opacity: 1; transform: none; }
  }
</style>
