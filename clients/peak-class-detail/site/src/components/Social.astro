---
// His clips as plain tiles next to the stats and links; fits one screen. TikTok leads: it is his main channel.
// To swap in his POV TikToks: put them in public/media/social/ (mp4 + webp poster) and list them here.
const clips = ['s5-paint', 'raptor', 'a3'];
const tiktok = 'https://www.tiktok.com/@peakclassdetail';
const links = [
  { name: 'TikTok', handle: '@peakclassdetail', href: tiktok },
  { name: 'Instagram', handle: '@peakclassdetail', href: 'https://www.instagram.com/peakclassdetail/' },
  { name: 'Facebook', handle: 'Peak Class Detail', href: 'https://www.facebook.com/profile.php?id=100092608838944' },
];
---
<section class="social" id="social">
  <div class="wrap social__grid">
    <div class="social__copy">
      <h2 class="display social__title rise">
        <span class="ln"><span>Patrzysz</span></span>
        <span class="ln"><span>nam na <em>ręce.</em></span></span>
      </h2>
      <p class="lead rise-fade">Na TikToku pokazujemy naszą robotę od środka, od brudnego auta do ostatniego przetarcia.</p>
      <dl class="social__stats rise-fade">
        <div><dt class="display"><span data-count="50">50</span> tys.</dt><dd>osób śledzi naszą pracę</dd></div>
        <div><dt class="display"><span data-count="1000">1000</span>+</dt><dd>aut przeszło przez nasze ręce</dd></div>
      </dl>
      <ul class="social__links rise-fade">
        {links.map((l) => (
          <li>
            <a class="act" href={l.href} target="_blank" rel="noopener">
              <span class="social__name">{l.name}</span> <span class="social__handle">{l.handle}</span> <span class="arr" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="social__clips">
      {clips.map((c) => (
        <a class="clip sweep" href={tiktok} target="_blank" rel="noopener" aria-label="Film na TikToku" data-strip>
          <video muted loop playsinline preload="none" poster={`/media/social/${c}.webp`} data-src={`/media/social/${c}.mp4`}></video>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .social {
    min-height: 100svh; display: grid; align-items: center;
    padding: clamp(5.5rem, 12vh, 8rem) 0 clamp(2.5rem, 7vh, 5rem);
    background: linear-gradient(180deg, var(--bg), var(--bg-2)); overflow: hidden;
  }
  .social__grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 5.5rem); align-items: center; }
  .social__title { font-size: clamp(2.2rem, 5.2vw, 5.4rem); }
  .social__copy { display: grid; gap: clamp(1.1rem, 2.6vh, 1.8rem); justify-items: start; }
  .social__copy .lead { max-width: 36ch; }
  .social__stats { margin: 0; display: flex; gap: 1rem 3rem; flex-wrap: wrap; }
  .social__stats dt { font-size: clamp(2rem, 3.4vw, 3.4rem); font-variant-numeric: tabular-nums; }
  .social__stats dd { margin: 0.3rem 0 0; color: var(--mute); font-size: 0.92rem; }
  .social__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .social__links .act { font-size: clamp(1rem, 1.3vw, 1.2rem); }
  .social__name { color: var(--ink); }
  .social__handle { color: var(--mute); font-weight: 500; }

  /* three plain 9:16 tiles, the middle one lifted */
  .social__clips { display: flex; gap: clamp(0.6rem, 1.2vw, 1.2rem); align-items: center; }
  .clip { flex: 1; aspect-ratio: 9 / 16; max-height: 70svh; overflow: hidden; background: var(--bg-3); box-shadow: 0 0 0 1px rgba(233, 237, 243, 0.08), 0 40px 70px -30px rgba(0, 0, 0, 0.9); }
  .clip:nth-child(2) { transform: translateY(-7%); }
  .clip:not(:nth-child(2)) { transform: translateY(5%); }
  .clip video { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 860px) {
    .social { min-height: 0; }
    .social__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
