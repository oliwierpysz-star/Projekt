---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@fontsource/knewave/latin-ext.css';
import '@fontsource/knewave/latin.css';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.jpg', { eager: true });
const photo = (n: string) => photos[`../assets/work/${n}.jpg`].default;
// cut-outs of his real cars (background removed), e.g. src/assets/cutouts/s5-car.png
const cutouts = import.meta.glob<{ default: ImageMetadata }>('../assets/cutouts/*.png', { eager: true });
const cutout = (n: string) => cutouts[`../assets/cutouts/${n}.png`]?.default;

// Each job is a poster: three panels folded like a screen behind the car, the make painted in brush
// across the bottom, the work done in a bracketed note. Panels: a photo, his clip, or a dark panel
// with the model painted on it (when there are only two shots).
type Panel = { img: string } | { video: string } | { paint: string };
const cars: { make: string; model: string; what: string; done: string[]; car: string; fy: number; panels: Panel[] }[] = [
  { make: 'Audi', model: 'S5', what: 'Detailing lakieru i wnętrza', done: ['Detailing lakieru', 'Detailing wnętrza'], car: 's5-car', fy: 0.72, panels: [{ img: 's5-cockpit' }, { video: 's5' }, { img: 's5-wheel' }] },
  { make: 'Golf', model: 'GTI', what: 'Korekta lakieru i pielęgnacja całego wnętrza', done: ['Korekta lakieru', 'Pielęgnacja całego wnętrza'], car: 'golf-car', fy: 0.55, panels: [{ img: 'golf-cockpit' }, { video: 'golf' }, { img: 'golf-floor' }] },
  { make: 'Mercedes', model: 'A45', what: 'Full detail z aplikacją wosku', done: ['Full detail', 'Aplikacja wosku'], car: 'a45-car', fy: 0.6, panels: [{ img: 'a45-cockpit' }, { video: 'a45' }, { img: 'a45-vents' }] },
  { make: 'BMW', model: 'F11', what: 'Full detail: lakier, dekontaminacja i wnętrze', done: ['Lakier', 'Dekontaminacja', 'Wnętrze'], car: 'f11-car', fy: 0.55, panels: [{ img: 'f11-leather' }, { video: 'f11' }, { img: 'f11-wheel' }] },
  { make: 'BMW', model: 'F45', what: 'Kompleksowa metamorfoza', done: ['Kompleksowa metamorfoza'], car: 'f45-car', fy: 0.76, panels: [{ img: 'f45-side' }, { video: 'f45' }, { paint: 'F45' }] },
];
// brush name size: long makes get smaller so every name fits the left ~60% of the poster
const nameSize = (s: string) => Math.min(20, 48 / (s.length * 0.52));
// paint drips under the name, placed from the letters so each poster differs but stays the same between builds
const drips = (s: string) => [...s].slice(0, 3).map((ch, i) => ({ x: 12 + ((ch.charCodeAt(0) * 37 + i * 29) % 70), h: 5 + ((ch.charCodeAt(0) * 13 + i * 7) % 9) }));
---
<section class="work" id="realizacje">
  <div class="wrap work__head">
    <h2 class="display h2 rise">
      <span class="ln"><span>Lśnią</span></span>
      <span class="ln"><span>po <em>nas.</em></span></span>
    </h2>
    <div class="work__side">
      <p class="lead rise-fade">Prawdziwe auta naszych klientów, prosto z ich podjazdów. Więcej na Instagramie.</p>
      <div class="work__ctrl" aria-label="Przewijanie realizacji">
        <button type="button" class="work__arr" data-work-prev aria-label="Poprzednia realizacja">←</button>
        <span class="work__count" aria-live="polite"><b data-work-i>1</b> / {cars.length}</span>
        <button type="button" class="work__arr" data-work-next aria-label="Następna realizacja">→</button>
      </div>
    </div>
  </div>

  <div class="work__track" data-work-track tabindex="0" aria-label="Realizacje">
    {cars.map((c) => {
      const cut = cutout(c.car);
      return (
        <figure class:list={['job', { 'job--cut': cut }]} data-poster>
          <div class="job__art">
            {cut && (
              <div class="job__wall" aria-hidden="true">
                <span class="job__tag job__tag--1">{c.make}{drips(c.make).map((d) => <i style={`left:${d.x}%;--h:${d.h * 0.7}cqw`}></i>)}</span>
                <span class="job__tag job__tag--2">{c.model}</span>
              </div>
            )}
            {cut && (
              <p class="job__top" aria-hidden="true"><b>{c.make} {c.model}</b><span>Czysty komfort.</span></p>
            )}
            <div class="job__panels">
              {c.panels.map((p) => (
                <div class="job__panel sweep" data-strip>
                  {'img' in p ? (
                    <Image src={photo(p.img)} alt="" widths={[200, 360, 520]} sizes="(max-width: 760px) 26vw, 180px" loading="lazy" />
                  ) : 'video' in p ? (
                    <video muted loop playsinline preload="none" poster={`/media/${p.video}.webp`} data-src={`/media/${p.video}.mp4`}></video>
                  ) : (
                    <span class="job__paint" aria-hidden="true">{p.paint}</span>
                  )}
                </div>
              ))}
            </div>
            {cut ? (
              <div class="job__cut">
                <Image src={cut} alt={`${c.make} ${c.model} po detailingu`} widths={[480, 800, 1200]} sizes="(max-width: 760px) 80vw, 520px" loading="lazy" />
              </div>
            ) : (
              <div class="job__car" style={`--fy:${c.fy * 100}%`}>
                <Image src={photo(c.car)} alt={`${c.make} ${c.model} po detailingu`} widths={[360, 640, 960]} sizes="(max-width: 760px) 60vw, 340px" loading="lazy" />
              </div>
            )}
            {cut && (
              <ul class="job__done" aria-label="Zakres prac">
                {c.done.map((d) => <li>{d}</li>)}
              </ul>
            )}
          </div>
          <figcaption>
            <b class="job__name" style={`--fs:${nameSize(c.make)}cqw`}>
              <span class="job__make">{c.make}</span>
              <em class="job__model">{c.model}</em>
              {drips(c.make).map((d) => <i class="job__drip" style={`left:${d.x}%;--h:${d.h}cqw`} aria-hidden="true"></i>)}
            </b>
            <span class="job__what">{c.what}</span>
          </figcaption>
        </figure>
      );
    })}
    <a class="job job--more" href="https://www.instagram.com/peakclassdetail/" target="_blank" rel="noopener">
      <span class="job__more">Więcej na <em>Instagramie</em></span>
      <span class="act">@peakclassdetail <span class="arr" aria-hidden="true">→</span></span>
    </a>
  </div>
</section>

<style>
  .work { padding: clamp(5.625rem, 14vh, 10.625rem) 0; background: linear-gradient(180deg, var(--bg-2), var(--bg)); }
  .work__head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: end; margin-bottom: clamp(2.25rem, 5vh, 4rem); }
  .work__side { display: grid; gap: 1.6rem; }
  .work__ctrl { display: flex; align-items: center; gap: 1.2rem; }
  .work__arr { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--hair); font-size: 1.1rem; transition: border-color 0.3s, background 0.3s; }
  .work__arr:hover { border-color: var(--accent); background: var(--accent-soft); }
  .work__arr:disabled { opacity: 0.3; pointer-events: none; }
  .work__count { font-variant-numeric: tabular-nums; color: var(--mute); font-stretch: 112%; min-width: 4.5ch; text-align: center; }
  .work__count b { color: var(--ink); font-weight: 700; }

  .work__track {
    --edge: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    display: flex; gap: clamp(1.5rem, 3vw, 3rem);
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
    padding: 4px var(--edge) 8px;
    scrollbar-width: none; cursor: grab;
  }
  .work__track::-webkit-scrollbar { display: none; }
  .work__track.is-drag { cursor: grabbing; scroll-snap-type: none; }
  .work__track.is-drag * { pointer-events: none; }

  /* fallback card (no cut-out yet): detail panels on top, the car photo in front */
  .job { flex: 0 0 clamp(17.5rem, 30vw, 27rem); min-width: 0; margin: 0; scroll-snap-align: start; }
  .job__art { container-type: inline-size; position: relative; aspect-ratio: 10 / 11; }
  .job__panels { position: absolute; left: 0; right: 0; top: 0; display: flex; gap: 3%; }
  .job__panel { flex: 1; aspect-ratio: 2 / 3; overflow: hidden; background: var(--bg-3); }
  .job__panel img, .job__panel video { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.62) saturate(0.85); transition: filter 0.5s; }
  .job:hover .job__panel img, .job:hover .job__panel video { filter: brightness(0.85) saturate(1); }
  .job__car { position: absolute; left: 14%; right: 14%; bottom: 0; aspect-ratio: 1 / 1; overflow: hidden; background: var(--bg-3); box-shadow: 0 34px 60px -18px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(233, 237, 243, 0.08); }
  .job__car img { width: 100%; height: 100%; object-fit: cover; object-position: 50% var(--fy, 50%); }
  .job figcaption { margin-top: 1.1rem; display: grid; gap: 0.35rem; }
  .job__name { font-stretch: 125%; font-weight: 860; text-transform: uppercase; font-size: clamp(1.5rem, 2.2vw, 2.1rem); line-height: 1; }
  .job__model { color: var(--accent); font-style: normal; }
  .job__drip { display: none; }
  .job__what { color: var(--mute); font-size: 0.92rem; }

  /* ---- poster: one per car, his real car cut out in front ---- */
  .job--cut { flex-basis: clamp(19rem, 34vw, 33rem); position: relative; container-type: inline-size; }
  /* no card: the poster sits straight on the section, only a soft pool of light under the car */
  .job--cut .job__art { aspect-ratio: 3 / 4; background: radial-gradient(60% 30% at 50% 66%, rgba(91, 140, 255, 0.07), transparent 70%); }
  /* graffiti sprayed on the wall behind: rough spray edges, overspray haze, drips; fades out at the edges so there is no box */
  .job__wall {
    position: absolute; inset: 0 -8%; pointer-events: none;
    /* speckle = spray grain on the letters; radial = the wall fades out instead of ending in a box */
    -webkit-mask-image: url(/tex/speckle.png), radial-gradient(closest-side, #000 62%, transparent);
    mask-image: url(/tex/speckle.png), radial-gradient(closest-side, #000 62%, transparent);
    -webkit-mask-size: 60cqw auto, 100% 100%; mask-size: 60cqw auto, 100% 100%;
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  .job__tag { position: absolute; font-family: 'Knewave', sans-serif; text-transform: uppercase; line-height: 0.8; white-space: nowrap; }
  .job__tag i { position: absolute; top: 78%; width: 0.7cqw; height: var(--h); border-radius: 0 0 1cqw 1cqw; background: linear-gradient(180deg, currentColor 55%, transparent); }
  /* filled piece in white paint */
  .job__tag--1 { left: 0; top: 17%; font-size: 36cqw; transform: rotate(-9deg); color: rgba(233, 237, 243, 0.22); text-shadow: 0 0 1.4cqw rgba(233, 237, 243, 0.14), 0 0 5cqw rgba(233, 237, 243, 0.06); }
  /* outline throw-up in the accent blue, with a hard shadow like a second colour */
  .job__tag--2 { right: 2%; top: 40%; font-size: 40cqw; transform: rotate(-6deg); color: transparent; -webkit-text-stroke: 0.55cqw rgba(91, 140, 255, 0.5); text-shadow: 1.2cqw 1.2cqw 0 rgba(91, 140, 255, 0.1); }

  .job__top { position: absolute; left: 0; right: 0; top: 4.5%; z-index: 2; display: grid; justify-items: center; gap: 0.5cqw; text-transform: uppercase; letter-spacing: 0.32em; font-size: 2.7cqw; }
  .job__top b { color: var(--accent); font-weight: 700; }
  .job__top span { color: var(--ink); font-weight: 600; letter-spacing: 0.22em; }

  /* three panels folded like a screen: the sides turn inwards, so their ends are cut on a slant */
  .job--cut .job__panels { left: 3%; right: 3%; top: 13%; gap: 1%; align-items: flex-start; perspective: 140cqw; }
  .job--cut .job__panel { aspect-ratio: 9 / 17; box-shadow: 0 30px 50px -20px rgba(0, 0, 0, 0.9); background: #0a0c10; }
  .job--cut .job__panel:nth-child(1) { margin-top: 5%; transform: rotateY(-26deg); transform-origin: 100% 50%; }
  .job--cut .job__panel:nth-child(2) { flex-grow: 1.15; z-index: 1; }
  .job--cut .job__panel:nth-child(3) { margin-top: 5%; transform: rotateY(26deg); transform-origin: 0 50%; }
  .job--cut .job__panel img, .job--cut .job__panel video { filter: brightness(0.7) saturate(0.9); }
  .job__paint { display: grid; place-items: center; height: 100%; font-family: 'Knewave', sans-serif; font-size: 13cqw; color: rgba(233, 237, 243, 0.14); writing-mode: vertical-rl; transform: rotate(180deg); background: linear-gradient(180deg, #161a21, #0a0c10); }

  .job__cut { position: absolute; left: 3%; right: 3%; bottom: 21%; height: 44%; z-index: 3; }
  .job__cut img {
    width: 100%; height: 100%; object-fit: contain; object-position: 50% 100%;
    filter: drop-shadow(0 16px 14px rgba(0, 0, 0, 0.7));
    -webkit-box-reflect: below -2px linear-gradient(transparent 70%, rgba(255, 255, 255, 0.14));
  }

  /* brush name across the bottom, over the floor: make in paint, model in the accent */
  .job--cut figcaption { margin: 0; }
  .job--cut .job__name {
    position: absolute; left: 5%; right: 40%; bottom: 7%; z-index: 4; white-space: nowrap;
    font-family: 'Knewave', sans-serif; font-weight: 400; font-stretch: normal;
    font-size: var(--fs); line-height: 0.9; letter-spacing: -0.01em; color: #eef2f7;
    transform: rotate(-5deg); transform-origin: 0 100%;
    text-shadow: 0 6px 22px rgba(0, 0, 0, 0.55);
  }
  .job--cut .job__model { font-size: 0.42em; margin-left: 0.15em; letter-spacing: 0; }
  .job--cut .job__drip { display: block; position: absolute; top: 82%; width: 0.6cqw; height: var(--h); border-radius: 0 0 1cqw 1cqw; background: linear-gradient(180deg, #eef2f7 60%, rgba(238, 242, 247, 0)); }
  .job--cut .job__what { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  /* the work done, in a bracketed note with a hatched rule under it */
  .job__done {
    position: absolute; right: 5%; bottom: 9%; z-index: 4; list-style: none; margin: 0;
    padding: 2cqw 2.4cqw 2.4cqw; max-width: 31%;
    font-size: 2.2cqw; line-height: 1.5; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; color: var(--ink);
    background:
      linear-gradient(var(--ink), var(--ink)) 0 0 / 2cqw 1px, linear-gradient(var(--ink), var(--ink)) 0 0 / 1px 2cqw,
      linear-gradient(var(--ink), var(--ink)) 100% 0 / 2cqw 1px, linear-gradient(var(--ink), var(--ink)) 100% 0 / 1px 2cqw,
      linear-gradient(var(--ink), var(--ink)) 0 100% / 2cqw 1px, linear-gradient(var(--ink), var(--ink)) 0 100% / 1px 2cqw,
      linear-gradient(var(--ink), var(--ink)) 100% 100% / 2cqw 1px, linear-gradient(var(--ink), var(--ink)) 100% 100% / 1px 2cqw,
      rgba(6, 8, 11, 0.45);
    background-repeat: no-repeat;
  }
  .job__done::after { content: ''; position: absolute; left: 2.6cqw; right: 2.6cqw; bottom: -2.4cqw; height: 0.9cqw; background: repeating-linear-gradient(115deg, var(--ink) 0 1px, transparent 1px 0.8cqw); opacity: 0.6; }

  .job--more { container-type: inline-size; display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 3 / 4; flex-basis: clamp(17rem, 26vw, 24rem); padding: 8%; background: radial-gradient(90% 70% at 50% 35%, #1a1f27, #0b0e12 72%); align-self: flex-start; }
  .job__more { font-family: 'Knewave', sans-serif; text-transform: uppercase; font-size: 14cqw; line-height: 0.95; transform: rotate(-5deg); transform-origin: 0 0; }
  .job__more em { font-style: normal; color: var(--accent); display: block; }

  @media (max-width: 760px) {
    .work__head { grid-template-columns: 1fr; gap: 1rem; }
    .job, .job--cut { flex-basis: 82vw; }
    .work__arr { width: 44px; height: 44px; }
  }
</style>
