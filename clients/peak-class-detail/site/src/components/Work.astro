---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.jpg', { eager: true });
const photo = (n: string) => photos[`../assets/work/${n}.jpg`].default;

// Each job: the car's front photo stands in front of a row of detail panels (photos and his clip).
type Panel = { img: string } | { video: string };
// fy: vertical focus of the front photo (the car sits low in his phone shots)
const cars: { make: string; model: string; what: string; car: string; fy: number; panels: Panel[] }[] = [
  { make: 'Audi', model: 'S5', what: 'Detailing lakieru i wnętrza', car: 's5-car', fy: 0.72, panels: [{ img: 's5-cockpit' }, { video: 's5' }, { img: 's5-wheel' }] },
  { make: 'Golf', model: 'GTI', what: 'Korekta lakieru i pielęgnacja całego wnętrza', car: 'golf-car', fy: 0.55, panels: [{ img: 'golf-cockpit' }, { video: 'golf' }, { img: 'golf-floor' }] },
  { make: 'Mercedes', model: 'A45', what: 'Full detail z aplikacją wosku', car: 'a45-car', fy: 0.6, panels: [{ img: 'a45-cockpit' }, { video: 'a45' }, { img: 'a45-vents' }] },
  { make: 'BMW', model: 'F11', what: 'Full detail: lakier, dekontaminacja i wnętrze', car: 'f11-car', fy: 0.55, panels: [{ img: 'f11-leather' }, { video: 'f11' }, { img: 'f11-wheel' }] },
  { make: 'BMW', model: 'F45', what: 'Kompleksowa metamorfoza', car: 'f45-car', fy: 0.76, panels: [{ img: 'f45-side' }, { video: 'f45' }] },
];
---
<section class="work" id="realizacje">
  <div class="wrap work__head">
    <h2 class="display h2 rise">
      <span class="ln"><span>Lśnią</span></span>
      <span class="ln"><span>po <em>nas.</em></span></span>
    </h2>
    <div class="work__side">
      <p class="lead rise-fade">Prawdziwe auta naszych klientów, prosto z ich podjazdów. Więcej na Instagramie.</p>
      <div class="work__ctrl" aria-label="Przewijanie realizacji">
        <button type="button" class="work__arr" data-work-prev aria-label="Poprzednia realizacja">←</button>
        <span class="work__count" aria-live="polite"><b data-work-i>1</b> / {cars.length}</span>
        <button type="button" class="work__arr" data-work-next aria-label="Następna realizacja">→</button>
      </div>
    </div>
  </div>

  <div class="work__track" data-work-track tabindex="0" aria-label="Realizacje">
    {cars.map((c) => (
      <figure class="job" data-poster>
        <div class="job__art">
          <div class="job__panels">
            {c.panels.map((p) => (
              <div class="job__panel sweep" data-strip>
                {'img' in p ? (
                  <Image src={photo(p.img)} alt="" widths={[200, 360, 520]} sizes="(max-width: 760px) 26vw, 160px" loading="lazy" />
                ) : (
                  <video muted loop playsinline preload="none" poster={`/media/${p.video}.webp`} data-src={`/media/${p.video}.mp4`}></video>
                )}
              </div>
            ))}
          </div>
          <div class="job__car" style={`--fy:${c.fy * 100}%`}>
            <Image src={photo(c.car)} alt={`${c.make} ${c.model} po detailingu`} widths={[360, 640, 960]} sizes="(max-width: 760px) 60vw, 340px" loading="lazy" />
          </div>
        </div>
        <figcaption>
          <b class="display"><span>{c.make}</span> <em>{c.model}</em></b>
          <span>{c.what}</span>
        </figcaption>
      </figure>
    ))}
    <a class="job job--more" href="https://www.instagram.com/peakclassdetail/" target="_blank" rel="noopener">
      <span class="display">Więcej na<br /><em>Instagramie</em></span>
      <span class="act">@peakclassdetail <span class="arr" aria-hidden="true">→</span></span>
    </a>
  </div>
</section>

<style>
  .work { padding: clamp(5.625rem, 14vh, 10.625rem) 0; background: linear-gradient(180deg, var(--bg-2), var(--bg)); }
  .work__head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: end; margin-bottom: clamp(2.25rem, 5vh, 4rem); }
  .work__side { display: grid; gap: 1.6rem; }
  .work__ctrl { display: flex; align-items: center; gap: 1.2rem; }
  .work__arr { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--hair); font-size: 1.1rem; transition: border-color 0.3s, background 0.3s; }
  .work__arr:hover { border-color: var(--accent); background: var(--accent-soft); }
  .work__arr:disabled { opacity: 0.3; pointer-events: none; }
  .work__count { font-variant-numeric: tabular-nums; color: var(--mute); font-stretch: 112%; min-width: 4.5ch; text-align: center; }
  .work__count b { color: var(--ink); font-weight: 700; }

  .work__track {
    --edge: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    display: flex; gap: clamp(1.5rem, 3vw, 3rem);
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
    padding: 4px var(--edge) 8px;
    scrollbar-width: none; cursor: grab;
  }
  .work__track::-webkit-scrollbar { display: none; }
  .work__track.is-drag { cursor: grabbing; scroll-snap-type: none; }
  .work__track.is-drag * { pointer-events: none; }

  .job { flex: 0 0 clamp(17.5rem, 30vw, 27rem); min-width: 0; margin: 0; scroll-snap-align: start; }
  .job__art { container-type: inline-size; position: relative; aspect-ratio: 10 / 11; }
  /* back row: detail panels, slightly dimmed so the car in front reads first */
  .job__panels { position: absolute; left: 0; right: 0; top: 0; display: flex; gap: 3%; }
  .job__panel { flex: 1; aspect-ratio: 2 / 3; overflow: hidden; background: var(--bg-3); }
  .job__panel img, .job__panel video { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.62) saturate(0.85); transition: filter 0.5s; }
  .job:hover .job__panel img, .job:hover .job__panel video { filter: brightness(0.85) saturate(1); }
  /* front: the car itself */
  .job__car { position: absolute; left: 14%; right: 14%; bottom: 0; aspect-ratio: 1 / 1; overflow: hidden; background: var(--bg-3); box-shadow: 0 34px 60px -18px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(233, 237, 243, 0.08); }
  .job__car img { width: 100%; height: 100%; object-fit: cover; object-position: 50% var(--fy, 50%); }
  .job figcaption { margin-top: 1.1rem; display: grid; gap: 0.35rem; }
  .job figcaption b { font-size: clamp(1.5rem, 2.2vw, 2.1rem); }
  .job figcaption > span { color: var(--mute); font-size: 0.92rem; }

  .job--more { container-type: inline-size; display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 5 / 6; padding: 8%; background: linear-gradient(160deg, var(--bg-3), var(--bg)); align-self: flex-start; }
  .job--more .display { font-size: 10cqw; }

  @media (max-width: 760px) {
    .work__head { grid-template-columns: 1fr; gap: 1rem; }
    .job { flex-basis: 82vw; }
    .work__arr { width: 44px; height: 44px; }
  }
</style>
