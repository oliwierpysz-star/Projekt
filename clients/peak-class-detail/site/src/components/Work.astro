---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@fontsource/knewave/latin-ext.css';
import '@fontsource/knewave/latin.css';
import JobCase from './JobCase.astro';
import jobs from '../data/jobs.json';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.jpg', { eager: true });
const photo = (n: string) => photos[`../assets/work/${n}.jpg`].default;
// cut-outs of his real cars (background removed), e.g. src/assets/cutouts/s5-car.png
const cutouts = import.meta.glob<{ default: ImageMetadata }>('../assets/cutouts/*.png', { eager: true });
const cutout = (n: string) => cutouts[`../assets/cutouts/${n}.png`]?.default;

// Each job is a poster: three panels folded like a screen behind his real car (cut out), the make
// painted in brush across the bottom, the work done in a bracketed note. Clicking a poster opens
// the job up close with his clip. Panels: a photo, his clip, or a dark panel with the model painted on it.
type Panel = { img: string } | { video: string } | { paint: string };
const all: { slug: string; make: string; model: string; what: string; done: string[]; car: string; video: string; panels: Panel[] }[] = [
  { slug: 'audi-s5', make: 'Audi', model: 'S5', what: 'Detailing lakieru i wnętrza', done: ['Detailing lakieru', 'Detailing wnętrza'], car: 's5-car', video: 's5', panels: [{ img: 's5-cockpit' }, { video: 's5' }, { img: 's5-wheel' }] },
  { slug: 'golf-gti', make: 'Golf', model: 'GTI', what: 'Korekta lakieru i pielęgnacja całego wnętrza', done: ['Korekta lakieru', 'Pielęgnacja całego wnętrza'], car: 'golf-car', video: 'golf', panels: [{ img: 'golf-cockpit' }, { video: 'golf' }, { img: 'golf-floor' }] },
  { slug: 'mercedes-a45', make: 'Mercedes', model: 'A45', what: 'Full detail z aplikacją wosku', done: ['Full detail', 'Aplikacja wosku'], car: 'a45-car', video: 'a45', panels: [{ img: 'a45-cockpit' }, { video: 'a45' }, { img: 'a45-vents' }] },
  { slug: 'bmw-f11', make: 'BMW', model: 'F11', what: 'Full detail: lakier, dekontaminacja i wnętrze', done: ['Lakier', 'Dekontaminacja', 'Wnętrze'], car: 'f11-car', video: 'f11', panels: [{ img: 'f11-leather' }, { video: 'f11' }, { img: 'f11-wheel' }] },
  { slug: 'bmw-f45', make: 'BMW', model: 'F45', what: 'Kompleksowa metamorfoza', done: ['Kompleksowa metamorfoza'], car: 'f45-car', video: 'f45', panels: [{ img: 'f45-side' }, { video: 'f45' }, { paint: 'F45' }] },
];
const cars = all.filter((c) => cutout(c.car));
// the carousel runs endlessly: three copies, the middle one is where it drifts; the others are for the wrap
const copies = [0, 1, 2];
// brush name size: long makes get smaller so every name fits the left ~60% of the poster
const nameSize = (s: string) => Math.min(20, 48 / (s.length * 0.52));
// paint drips under the name, placed from the letters so each poster differs but stays the same between builds
const drips = (s: string) => [...s].slice(0, 3).map((ch, i) => ({ x: 12 + ((ch.charCodeAt(0) * 37 + i * 29) % 70), h: 5 + ((ch.charCodeAt(0) * 13 + i * 7) % 9) }));
---
<section class="work" id="lista">
  <div class="wrap work__head">
    <h2 class="display h2 rise">
      <span class="ln"><span>Prosto z</span></span>
      <span class="ln"><span><em>podjazdu.</em></span></span>
    </h2>
    <div class="work__side">
      <p class="lead rise-fade">Prawdziwe auta naszych klientów, prosto z ich podjazdów. Kliknij auto, żeby zobaczyć je z bliska.</p>
      <div class="work__ctrl">
        <div class="work__nav" aria-label="Przewijanie realizacji">
          <button type="button" class="work__arr" data-work-prev aria-label="Poprzednia realizacja">←</button>
          <span class="work__count" aria-live="polite"><b data-work-i>1</b> / {cars.length}</span>
          <button type="button" class="work__arr" data-work-next aria-label="Następna realizacja">→</button>
        </div>
        <a class="act" href="https://www.instagram.com/peakclassdetail/" target="_blank" rel="noopener">Więcej na Instagramie <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <div class="work__track" data-work-track tabindex="0" aria-label="Realizacje, przewijają się same; przeciągnij, żeby przewinąć">
    {copies.map((k) => cars.map((c, i) => (
      <figure class="job" data-poster data-copy={k} aria-hidden={k !== 1 ? 'true' : undefined} inert={k !== 1 ? true : undefined}>
        <div class="job__art">
          <div class="job__wall" aria-hidden="true">
            <span class="job__tag job__tag--1">{c.make}{drips(c.make).map((d) => <i style={`left:${d.x}%;--h:${d.h * 0.7}cqw`}></i>)}</span>
            <span class="job__tag job__tag--2">{c.model}</span>
          </div>
          <div class="job__furn" aria-hidden="true">
            <span class="job__mark"><svg viewBox="0 0 40 40"><path d="M6 9h28L20 33z" /></svg>Peak Class</span>
            <span class="job__top"><b>{c.make} {c.model}</b><span>Czysty komfort.</span></span>
            <span class="job__side">Detailing<br />door to door</span>
            <span class="job__note">Śląsk<br />i Małopolska</span>
          </div>
          <div class="job__panels">
            {c.panels.map((p, j) => (
              <div class="job__panel sweep" data-strip>
                {'img' in p ? (
                  <Image src={photo(p.img)} alt="" widths={[240, 420, 600]} sizes="(max-width: 760px) 28vw, 220px" loading="lazy" />
                ) : 'video' in p ? (
                  <video muted loop playsinline preload="none" poster={`/media/${p.video}.webp`} data-src={`/media/${p.video}.mp4`}></video>
                ) : (
                  <span class="job__paint">{p.paint}</span>
                )}
                {j === 1 && <span class="job__slogan" aria-hidden="true">Odbiór.<br />Detailing.<br />Zwrot.</span>}
              </div>
            ))}
          </div>
          <div class="job__cut">
            <Image src={cutout(c.car)!} alt={`${c.make} ${c.model} po detailingu`} widths={[480, 800, 1200]} sizes="(max-width: 760px) 80vw, 600px" loading="lazy" />
          </div>
          <ul class="job__done" aria-label="Zakres prac">
            {c.done.map((d) => <li>{d}</li>)}
          </ul>
        </div>
        <figcaption>
          <b class="job__name" style={`--fs:${nameSize(c.make)}cqw`}>
            <span class="job__make">{c.make}</span>
            <em class="job__model">{c.model}</em>
            {drips(c.make).map((d) => <i class="job__drip" style={`left:${d.x}%;--h:${d.h}cqw`} aria-hidden="true"></i>)}
          </b>
          <span class="job__what">{c.what}</span>
        </figcaption>
        <button class="job__open" type="button" data-case-open={c.slug} aria-label={`Zobacz z bliska: ${c.make} ${c.model}`}><span class="act">Zobacz z bliska <span class="arr" aria-hidden="true">→</span></span></button>
      </figure>
    )))}
  </div>

  <div class="wrap work__all">
    <a class="act" href="/realizacje">Wszystkie realizacje ({jobs.length}) <span class="arr" aria-hidden="true">→</span></a>
  </div>

  {jobs.filter((j) => cars.some((c) => c.slug === j.slug)).map((j) => <JobCase job={j} />)}
</section>

<style>
  .work { padding: clamp(5.625rem, 14vh, 10.625rem) 0; }
  .work__head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: end; margin-bottom: clamp(1.5rem, 4vh, 3rem); }
  .work__side { display: grid; gap: 1.6rem; }
  .work__ctrl { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.4rem; }
  .work__nav { display: flex; align-items: center; gap: 1.2rem; }
  .work__arr { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--hair); font-size: 1.1rem; transition: border-color 0.3s, background 0.3s; }
  .work__arr:hover { border-color: var(--accent); background: var(--accent-soft); }
  .work__count { font-variant-numeric: tabular-nums; color: var(--mute); font-stretch: 112%; min-width: 4.5ch; text-align: center; }
  .work__count b { color: var(--ink); font-weight: 700; }

  /* endless, slowly drifting row (driven in main.ts); native scroll underneath, so drag and swipe just work */
  .work__track {
    display: flex; gap: clamp(1rem, 2.4vw, 3rem);
    overflow-x: auto; overscroll-behavior-x: contain;
    padding: 4px 0 8px;
    scrollbar-width: none; cursor: grab;
  }
  .work__track::-webkit-scrollbar { display: none; }
  .work__track.is-drag { cursor: grabbing; }
  .work__track.is-drag * { pointer-events: none; }

  /* ---- poster: sized by the screen height so a whole poster is always in view ---- */
  .job { flex: 0 0 min(46vw, calc(76svh * 0.75)); min-width: 0; margin: 0; position: relative; container-type: inline-size; }
  .job__art { position: relative; aspect-ratio: 3 / 4; background: radial-gradient(60% 30% at 50% 66%, rgba(91, 140, 255, 0.08), transparent 70%); }
  /* graffiti sprayed on the wall behind: spray grain, overspray haze, drips; fades out at the edges so there is no box */
  .job__wall {
    position: absolute; inset: 0 -8%; pointer-events: none;
    -webkit-mask-image: url(/tex/speckle.png), radial-gradient(closest-side, #000 62%, transparent);
    mask-image: url(/tex/speckle.png), radial-gradient(closest-side, #000 62%, transparent);
    -webkit-mask-size: 60cqw auto, 100% 100%; mask-size: 60cqw auto, 100% 100%;
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  .job__tag { position: absolute; font-family: 'Knewave', sans-serif; text-transform: uppercase; line-height: 0.8; white-space: nowrap; }
  .job__tag i { position: absolute; top: 78%; width: 0.7cqw; height: var(--h); border-radius: 0 0 1cqw 1cqw; background: linear-gradient(180deg, currentColor 55%, transparent); }
  .job__tag--1 { left: 0; top: 17%; font-size: 36cqw; transform: rotate(-9deg); color: rgba(233, 237, 243, 0.22); text-shadow: 0 0 1.4cqw rgba(233, 237, 243, 0.14), 0 0 5cqw rgba(233, 237, 243, 0.06); }
  .job__tag--2 { right: 2%; top: 40%; font-size: 40cqw; transform: rotate(-6deg); color: transparent; -webkit-text-stroke: 0.55cqw rgba(91, 140, 255, 0.5); text-shadow: 1.2cqw 1.2cqw 0 rgba(91, 140, 255, 0.1); }

  /* poster furniture, like the reference: mark top-left, title top-centre, notes at the sides */
  .job__furn { position: absolute; inset: 0; z-index: 2; pointer-events: none; text-transform: uppercase; }
  .job__mark { position: absolute; left: 5%; top: 4%; display: flex; align-items: center; gap: 1.2cqw; font-stretch: 125%; font-weight: 850; font-size: 2.3cqw; letter-spacing: 0.04em; }
  .job__mark svg { width: 3.6cqw; fill: none; stroke: var(--accent); stroke-width: 3.4; stroke-linejoin: round; }
  .job__top { position: absolute; left: 25%; right: 25%; top: 4%; display: grid; justify-items: center; gap: 0.6cqw; letter-spacing: 0.32em; font-size: 2.5cqw; }
  .job__top b { color: var(--accent); font-weight: 700; }
  .job__top span { color: var(--ink); font-weight: 600; letter-spacing: 0.22em; }
  .job__side { position: absolute; right: 5%; top: 4%; text-align: right; font-size: 1.9cqw; letter-spacing: 0.14em; line-height: 1.45; color: var(--mute); font-weight: 600; }
  .job__note { position: absolute; left: 5%; top: 9%; padding-left: 1.6cqw; border-left: 0.35cqw solid var(--accent); font-size: 1.8cqw; letter-spacing: 0.12em; line-height: 1.45; color: var(--mute); font-weight: 600; }

  /* three panels folded like a screen: the sides turn inwards, so their ends are cut on a slant */
  .job__panels { position: absolute; left: 3%; right: 3%; top: 15%; display: flex; gap: 1%; align-items: flex-start; perspective: 140cqw; }
  .job__panel { position: relative; flex: 1; aspect-ratio: 9 / 17; overflow: hidden; box-shadow: 0 30px 50px -20px rgba(0, 0, 0, 0.9); background: #0a0c10; }
  .job__panel:nth-child(1) { margin-top: 5%; transform: rotateY(-26deg); transform-origin: 100% 50%; }
  .job__panel:nth-child(2) { flex-grow: 1.15; z-index: 1; }
  .job__panel:nth-child(3) { margin-top: 5%; transform: rotateY(26deg); transform-origin: 0 50%; }
  .job__panel img, .job__panel video { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.7) saturate(0.9); transition: filter 0.5s; }
  .job:hover .job__panel img, .job:hover .job__panel video { filter: brightness(0.9) saturate(1); }
  .job__paint { display: grid; place-items: center; height: 100%; font-family: 'Knewave', sans-serif; font-size: 13cqw; color: rgba(233, 237, 243, 0.14); writing-mode: vertical-rl; transform: rotate(180deg); background: linear-gradient(180deg, #161a21, #0a0c10); }
  .job__slogan { position: absolute; left: 9%; top: 9%; font-size: 1.9cqw; letter-spacing: 0.3em; line-height: 1.6; text-transform: uppercase; font-weight: 600; color: rgba(233, 237, 243, 0.85); text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8); }

  .job__cut { position: absolute; left: 3%; right: 3%; bottom: 21%; height: 44%; z-index: 3; transition: transform 0.8s var(--ease); }
  .job:hover .job__cut { transform: translateY(-1.5%); }
  .job__cut img {
    width: 100%; height: 100%; object-fit: contain; object-position: 50% 100%;
    filter: drop-shadow(0 16px 14px rgba(0, 0, 0, 0.7));
    -webkit-box-reflect: below -2px linear-gradient(transparent 70%, rgba(255, 255, 255, 0.14));
  }

  /* brush name across the bottom, over the floor: make in paint, model in the accent */
  .job figcaption { margin: 0; }
  .job__name {
    position: absolute; left: 5%; right: 40%; bottom: 7%; z-index: 4; white-space: nowrap;
    font-family: 'Knewave', sans-serif; font-weight: 400; text-transform: uppercase;
    font-size: var(--fs); line-height: 0.9; letter-spacing: -0.01em; color: #eef2f7;
    transform: rotate(-5deg); transform-origin: 0 100%;
    text-shadow: 0 6px 22px rgba(0, 0, 0, 0.55);
  }
  .job__model { font-style: normal; color: var(--accent); font-size: 0.42em; margin-left: 0.15em; letter-spacing: 0; }
  .job__drip { position: absolute; top: 82%; width: 0.6cqw; height: var(--h); border-radius: 0 0 1cqw 1cqw; background: linear-gradient(180deg, #eef2f7 60%, rgba(238, 242, 247, 0)); }
  .job__what { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  /* the work done, in a bracketed note with a hatched rule under it */
  .job__done {
    position: absolute; right: 5%; bottom: 9%; z-index: 4; list-style: none; margin: 0;
    padding: 2cqw 2.4cqw 2.4cqw; max-width: 31%;
    font-size: 2.2cqw; line-height: 1.5; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; color: var(--ink);
    background:
      linear-gradient(var(--ink), var(--ink)) 0 0 / 2cqw 1px, linear-gradient(var(--ink), var(--ink)) 0 0 / 1px 2cqw,
      linear-gradient(var(--ink), var(--ink)) 100% 0 / 2cqw 1px, linear-gradient(var(--ink), var(--ink)) 100% 0 / 1px 2cqw,
      linear-gradient(var(--ink), var(--ink)) 0 100% / 2cqw 1px, linear-gradient(var(--ink), var(--ink)) 0 100% / 1px 2cqw,
      linear-gradient(var(--ink), var(--ink)) 100% 100% / 2cqw 1px, linear-gradient(var(--ink), var(--ink)) 100% 100% / 1px 2cqw,
      rgba(6, 8, 11, 0.45);
    background-repeat: no-repeat;
  }
  .job__done::after { content: ''; position: absolute; left: 2.6cqw; right: 2.6cqw; bottom: -2.4cqw; height: 0.9cqw; background: repeating-linear-gradient(115deg, var(--ink) 0 1px, transparent 1px 0.8cqw); opacity: 0.6; }

  /* the whole poster opens the close-up; the hint sits under the name */
  .job__open { position: absolute; inset: 0; z-index: 6; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 1.2cqw; cursor: pointer; }
  .job__open .act { font-size: max(0.8rem, 2.4cqw); opacity: 0; transform: translateY(6px); transition: opacity 0.4s, transform 0.5s var(--ease); }
  .job:hover .job__open .act, .job__open:focus-visible .act { opacity: 1; transform: none; }
  .work__track.is-drag .job__open { cursor: grabbing; }

  .work__all { margin-top: clamp(1.5rem, 4vh, 3rem); display: flex; justify-content: center; font-size: clamp(1.05rem, 1.4vw, 1.3rem); }

  @media (max-width: 760px) {
    .work__head { grid-template-columns: 1fr; gap: 1rem; }
    .job { flex-basis: 82vw; }
    .work__arr { width: 44px; height: 44px; }
    .job__open .act { opacity: 1; transform: none; }
  }
</style>
