---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.jpg', { eager: true });
const cutouts = import.meta.glob<{ default: ImageMetadata }>('../assets/cutouts/*.png', { eager: true });
const photo = (n: string) => photos[`../assets/work/${n}.jpg`].default;
const cutout = (n: string) => cutouts[`../assets/cutouts/${n}.png`]?.default;

type Panel = { img: string } | { video: string };
const cars: { id: string; make: string; model: string; what: string; panels: Panel[] }[] = [
  { id: 'audi-s5', make: 'Audi', model: 'S5', what: 'Detailing lakieru i wnętrza', panels: [{ img: 's5-engine' }, { video: 's5' }, { img: 's5-cockpit' }] },
  { id: 'golf-gti', make: 'Golf', model: 'GTI', what: 'Korekta lakieru i pielęgnacja całego wnętrza', panels: [{ img: 'golf-cockpit' }, { video: 'golf' }, { img: 'golf-floor' }] },
  { id: 'mercedes-a45', make: 'Mercedes', model: 'A45', what: 'Full detail z aplikacją wosku', panels: [{ img: 'a45-cockpit' }, { video: 'a45' }, { img: 'a45-vents' }] },
  { id: 'bmw-f11', make: 'BMW', model: 'F11', what: 'Full detail: lakier, dekontaminacja i wnętrze', panels: [{ img: 'f11-wheel' }, { video: 'f11' }, { img: 'f11-leather' }] },
  { id: 'bmw-f45', make: 'BMW', model: 'F45', what: 'Kompleksowa metamorfoza', panels: [{ img: 'f45-side' }, { video: 'f45' }] },
];

// Diagonal band of strips, MGA-poster style: left edge 16%→54%, right edge 50%→88% (bottom→top)
const xL = (y: number) => 16 + 38 * (1 - y / 100);
const xR = (y: number) => 50 + 38 * (1 - y / 100);
const clips = (n: number) => {
  const gap = 1.6;
  const h = (100 - gap * (n - 1)) / n;
  return Array.from({ length: n }, (_, i) => {
    const y0 = i * (h + gap);
    const y1 = y0 + h;
    return `polygon(${xL(y0)}% ${y0}%, ${xR(y0)}% ${y0}%, ${xR(y1)}% ${y1}%, ${xL(y1)}% ${y1}%)`;
  });
};
---
<section class="work" id="realizacje">
  <div class="wrap work__head">
    <h2 class="display h2 rise">
      <span class="ln"><span>Lśnią</span></span>
      <span class="ln"><span>po <em>nas.</em></span></span>
    </h2>
    <div class="work__side">
      <p class="lead rise-fade">Auta z ostatnich miesięcy, prosto z podjazdów naszych klientów. Więcej na Instagramie.</p>
      <div class="work__ctrl" aria-label="Przewijanie realizacji">
        <button type="button" class="work__arr" data-work-prev aria-label="Poprzednia realizacja">←</button>
        <span class="work__count" aria-live="polite"><b data-work-i>1</b> / {cars.length}</span>
        <button type="button" class="work__arr" data-work-next aria-label="Następna realizacja">→</button>
      </div>
    </div>
  </div>

  <div class="work__track" data-work-track tabindex="0" aria-label="Realizacje">
    {cars.map((c) => {
      const cut = cutout(c.id);
      const cp = clips(c.panels.length);
      return (
        <figure class="poster" data-poster>
          <div class="poster__art">
            <p class="poster__name display" aria-hidden="true" style={`--len:${Math.max(c.make.length, c.model.length)}`}><span>{c.make}</span><span>{c.model}</span></p>
            <p class="poster__name poster__name--flip display" aria-hidden="true"><span>{c.make}</span><span>{c.model}</span></p>
            {c.panels.map((p, i) => (
              <div class="poster__strip" style={`clip-path:${cp[i]}`} data-strip>
                {'img' in p ? (
                  <Image src={photo(p.img)} alt="" widths={[360, 640, 900]} sizes="(max-width: 760px) 80vw, 440px" loading="lazy" />
                ) : (
                  <video muted loop playsinline preload="none" poster={`/media/${p.video}.webp`} data-src={`/media/${p.video}.mp4`}></video>
                )}
              </div>
            ))}
            <div class="poster__car">
              {cut ? (
                <Image src={cut} alt={`${c.make} ${c.model} po detailingu`} widths={[480, 900, 1300]} sizes="(max-width: 760px) 80vw, 460px" loading="lazy" />
              ) : (
                <span class="poster__slot caption">Wycięte auto · {c.id}.png</span>
              )}
            </div>
          </div>
          <figcaption>
            <b>{c.make} {c.model}</b>
            <span>{c.what}</span>
          </figcaption>
        </figure>
      );
    })}
    <a class="poster poster--more" href="https://www.instagram.com/peakclassdetail/" target="_blank" rel="noopener">
      <span class="display">Więcej na<br /><em>Instagramie</em></span>
      <span class="act">@peakclassdetail <span class="arr" aria-hidden="true">→</span></span>
    </a>
  </div>
</section>

<style>
  .work { padding: clamp(5.625rem, 14vh, 10.625rem) 0; background: linear-gradient(180deg, var(--bg-2), var(--bg)); }
  .work__head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: end; margin-bottom: clamp(2.25rem, 5vh, 4rem); }
  .work__side { display: grid; gap: 1.6rem; }
  .work__ctrl { display: flex; align-items: center; gap: 1.2rem; }
  .work__arr { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--hair); font-size: 1.1rem; transition: border-color 0.3s, background 0.3s; }
  .work__arr:hover { border-color: var(--accent); background: var(--accent-soft); }
  .work__arr:disabled { opacity: 0.3; pointer-events: none; }
  .work__count { font-variant-numeric: tabular-nums; color: var(--mute); font-stretch: 112%; min-width: 4.5ch; text-align: center; }
  .work__count b { color: var(--ink); font-weight: 700; }

  .work__track {
    display: flex; gap: clamp(1rem, 2vw, 1.75rem);
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
    padding: 4px var(--edge) 8px;
    --edge: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    scrollbar-width: none;
    cursor: grab;
  }
  .work__track::-webkit-scrollbar { display: none; }
  .work__track.is-drag { cursor: grabbing; scroll-snap-type: none; }
  .work__track.is-drag * { pointer-events: none; }

  .poster { flex: 0 0 clamp(17.5rem, 31vw, 28.75rem); margin: 0; scroll-snap-align: start; }
  .poster__art { container-type: inline-size; position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: radial-gradient(90% 70% at 70% 30%, #121925, #07090d 70%); }
  .poster__name { position: absolute; left: 5%; top: 4%; z-index: 3; display: grid; font-size: min(19cqw, calc(84cqw / var(--len))); line-height: 0.86; color: var(--ink); }
  .poster__name span:last-child { color: var(--accent); }
  .poster__name--flip { left: auto; top: auto; right: 5%; bottom: 3%; transform: rotate(180deg); font-size: 5.5cqw; opacity: 0.45; z-index: 1; }
  .poster__strip { position: absolute; inset: 0; z-index: 2; }
  .poster__strip img, .poster__strip video { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.9) contrast(1.05); }
  .poster__car { position: absolute; z-index: 4; left: 3%; right: 3%; bottom: 7%; height: 48%; display: grid; place-items: end center; }
  .poster__car img { width: 100%; height: 100%; object-fit: contain; object-position: center bottom; filter: drop-shadow(0 24px 22px rgba(0, 0, 0, 0.65)); }
  .poster__slot { width: 100%; height: 100%; display: grid; place-items: center; border: 1px dashed rgba(233, 237, 243, 0.25); background: rgba(6, 8, 11, 0.55); text-align: center; padding: 1rem; }
  .poster figcaption { margin-top: 1rem; display: grid; gap: 0.2rem; }
  .poster figcaption b { font-stretch: 118%; font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; }
  .poster figcaption span { color: var(--mute); font-size: 0.92rem; }

  .poster--more { container-type: inline-size; display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 4 / 5; padding: 8%; background: linear-gradient(160deg, var(--bg-3), var(--bg)); align-self: flex-start; }
  .poster--more .display { font-size: 10cqw; }

  @media (max-width: 760px) {
    .work__head { grid-template-columns: 1fr; gap: 1rem; }
    .poster { flex-basis: 78vw; }
    .work__arr { width: 44px; height: 44px; }
  }
</style>
