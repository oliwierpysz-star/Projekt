---
---
<section class="polish" id="korekta" data-polish>
  <div class="polish__stage">
    <picture class="polish__still">
      <source media="(orientation: portrait)" srcset="/polish/corrected-phone.webp" />
      <img src="/polish/corrected-desktop.webp" alt="Czarny lakier po korekcie, gładki jak lustro pod lampą" width="2560" height="1440" loading="lazy" decoding="async" />
    </picture>
    <canvas class="polish__gl" data-polish-gl aria-hidden="true"></canvas>
    <div class="polish__shade" aria-hidden="true"></div>

    <div class="polish__copy wrap">
      <div class="polish__head">
        <p class="polish__state caption" aria-hidden="true"><span data-polish-before>Przed korektą</span><span data-polish-after>Po korekcie</span></p>
        <h2 class="display polish__title" data-polish-title>
          <span class="w">Rysy</span> <span class="w"><em>znikają.</em></span>
        </h2>
      </div>
      <!-- one stage at a time, centred under the car: each rises out of its line as the correction spreads -->
      <div class="polish__foot">
        <ol class="polish__steps" data-polish-steps>
          <li data-at="0.1"><b>Pod lampą</b><span>Hologramy i zarysowania widać dopiero w mocnym świetle.</span></li>
          <li data-at="0.38"><b>Korekta maszynowa</b><span>Usuwamy je warstwa po warstwie.</span></li>
          <li data-at="0.66"><b>Powłoka ceramiczna</b><span>Utrwala efekt na długo.</span></li>
        </ol>
        <a class="act act--accent polish__cta" href="#uslugi" data-polish-cta>Korekta lakieru od 1000 zł <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .polish { height: 300svh; background: var(--bg); }
  .polish__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .polish__still, .polish__still img, .polish__gl { position: absolute; inset: 0; width: 100%; height: 100%; }
  .polish__still img { object-fit: cover; }
  .polish__gl { opacity: 0; transition: opacity 0.5s; }
  .polish.is-gl .polish__gl { opacity: 1; }
  .polish__shade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, var(--bg) 0%, transparent 18%),
      linear-gradient(0deg, var(--bg) 0%, rgba(6, 8, 11, 0.6) 22%, transparent 50%);
  }
  .polish__copy { position: absolute; left: 0; right: 0; top: clamp(5.5rem, 13vh, 8rem); bottom: clamp(2rem, 7vh, 5rem); display: flex; flex-direction: column; align-items: center; justify-content: space-between; text-align: center; }
  .polish__head { display: grid; justify-items: center; gap: 0.8rem; }
  .polish__state { position: relative; height: 1.2em; width: 12em; }
  .polish__state span { position: absolute; left: 0; right: 0; top: 0; white-space: nowrap; transition: opacity 0.4s; }
  .polish__state span:last-child { opacity: 0; color: var(--accent); }
  .polish__title { font-size: clamp(3rem, 9vw, 10rem); }
  .polish__title .w { display: inline-block; opacity: 0.16; transition: opacity 0.5s; }
  .polish__title .w.is-lit { opacity: 1; }

  .polish__foot { display: grid; justify-items: center; gap: 1.2rem; }
  /* the stages share one line; the current one has risen into it, the others wait below or have left above */
  .polish__steps { list-style: none; margin: 0; padding: 0; display: grid; overflow: hidden; }
  .polish__steps li { grid-area: 1 / 1; display: grid; justify-items: center; gap: 0.3rem; transform: translateY(110%); opacity: 0; transition: transform 0.8s var(--ease), opacity 0.5s; }
  .polish__steps li.is-past { transform: translateY(-110%); opacity: 0; }
  .polish__steps li.is-now { transform: none; opacity: 1; }
  .polish__steps b { font-stretch: 120%; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; font-size: clamp(1.05rem, 1.5vw, 1.5rem); color: var(--ink); }
  .polish__steps span { color: var(--mute); font-size: clamp(0.95rem, 1.1vw, 1.1rem); }
  .polish__cta { opacity: 0; transform: translateY(12px); transition: opacity 0.6s, transform 0.7s var(--ease); }
  .polish__cta.is-on { opacity: 1; transform: none; }

  @media (orientation: portrait) {
    .polish__copy { top: calc(70px + 3vh); bottom: auto; }
    .polish__shade {
      background:
        linear-gradient(180deg, var(--bg) 0%, rgba(6, 8, 11, 0.65) 30%, transparent 55%),
        linear-gradient(0deg, var(--bg) 0%, transparent 16%);
    }
  }
  @media (max-width: 760px) {
    .polish__title { font-size: clamp(2.4rem, 12.5vw, 3.4rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .polish { height: auto; }
    .polish__stage { position: relative; }
    .polish__title .w { opacity: 1; }
    .polish__steps li:last-child, .polish__cta { opacity: 1; transform: none; }
  }
</style>
