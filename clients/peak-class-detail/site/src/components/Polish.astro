---
---
<section class="polish" id="korekta" data-polish>
  <div class="polish__stage">
    <picture class="polish__still">
      <source media="(orientation: portrait)" srcset="/polish/corrected-phone.webp" />
      <img src="/polish/corrected-desktop.webp" alt="Czarny lakier po korekcie, gładki jak lustro pod lampą" width="2560" height="1440" loading="lazy" decoding="async" />
    </picture>
    <canvas class="polish__gl" data-polish-gl aria-hidden="true"></canvas>
    <div class="polish__shade" aria-hidden="true"></div>

    <div class="polish__copy wrap">
      <p class="polish__state caption" aria-hidden="true"><span data-polish-before>Przed korektą</span><span data-polish-after>Po korekcie</span></p>
      <h2 class="display polish__title" data-polish-title>
        <span class="w">Rysy</span> <span class="w"><em>znikają.</em></span>
      </h2>
      <p class="polish__lead" data-polish-lead>Hologramy i zarysowania widać dopiero pod lampą. Maszynowa korekta lakieru usuwa je warstwa po warstwie, a powłoka ceramiczna utrwala efekt.</p>
      <a class="act act--accent" href="#uslugi" data-polish-lead>Korekta lakieru od 1000 zł <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .polish { height: 300svh; background: var(--bg); }
  .polish__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .polish__still, .polish__still img, .polish__gl { position: absolute; inset: 0; width: 100%; height: 100%; }
  .polish__still img { object-fit: cover; }
  .polish__gl { opacity: 0; transition: opacity 0.5s; }
  .polish.is-gl .polish__gl { opacity: 1; }
  .polish__shade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, var(--bg) 0%, transparent 18%),
      linear-gradient(0deg, var(--bg) 0%, rgba(6, 8, 11, 0.6) 22%, transparent 50%);
  }
  .polish__copy { position: absolute; left: 0; right: 0; bottom: clamp(2rem, 8vh, 6rem); display: grid; justify-items: start; gap: 1.1rem; }
  .polish__state { position: relative; height: 1.2em; }
  .polish__state span { position: absolute; left: 0; top: 0; white-space: nowrap; transition: opacity 0.4s; }
  .polish__state span:last-child { opacity: 0; color: var(--accent); }
  .polish__title { font-size: clamp(3rem, 9vw, 10rem); }
  .polish__title .w { display: inline-block; opacity: 0.16; transition: opacity 0.5s; }
  .polish__title .w.is-lit { opacity: 1; }
  .polish__lead:not(.act) { max-width: 44ch; color: var(--mute); }
  :global(.js) .polish [data-polish-lead] { opacity: 0; transform: translateY(14px); }

  @media (orientation: portrait) {
    .polish__copy { top: calc(70px + 3vh); bottom: auto; }
    .polish__shade {
      background:
        linear-gradient(180deg, var(--bg) 0%, rgba(6, 8, 11, 0.65) 30%, transparent 55%),
        linear-gradient(0deg, var(--bg) 0%, transparent 16%);
    }
  }
  @media (max-width: 760px) {
    .polish__title { font-size: clamp(2.4rem, 12.5vw, 3.4rem); }
    .polish__lead:not(.act) { font-size: 0.95rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .polish { height: auto; }
    .polish__stage { position: relative; }
    .polish__title .w { opacity: 1; }
    :global(.js) .polish [data-polish-lead] { opacity: 1; transform: none; }
  }
</style>
