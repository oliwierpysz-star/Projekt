---
---
<section class="hero" id="top" data-hero>
  <div class="hero__stage">
    <picture class="hero__still">
      <source media="(orientation: portrait)" srcset="/hero/a/clean-phone.webp" />
      <img src="/hero/a/clean-desktop.webp" alt="" width="2560" height="1440" fetchpriority="high" decoding="async" />
    </picture>
    <canvas class="hero__gl" data-hero-gl aria-hidden="true"></canvas>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="hero__copy wrap">
      <div class="hero__state hero__state--a" data-hero-a>
        <h1 class="display hero__title">
          <span class="ln"><span>Oddaj</span></span>
          <span class="ln"><span>kluczyki<em>.</em></span></span>
        </h1>
        <p class="hero__cue caption" data-hero-cue>Przewiń, żeby umyć <span aria-hidden="true">↓</span></p>
      </div>
      <div class="hero__state hero__state--b" data-hero-b>
        <p class="display hero__title" aria-hidden="true">
          <span class="ln"><span>Czysty</span></span>
          <span class="ln"><span>komfort<em>.</em></span></span>
        </p>
        <p class="hero__lead">Odbieramy auto spod Twoich drzwi i oddajemy je lśniące w to samo miejsce. Śląsk i Małopolska.</p>
        <div class="hero__acts">
          <a class="act act--accent" href="#wycena">Darmowa wycena <span class="arr" aria-hidden="true">→</span></a>
          <a class="phone" href="tel:+48881265265">881 265 265</a>
        </div>
      </div>
    </div>
  </div>
  <div class="pick" hidden data-hero-pick>
    <span>Wersja hero</span>
    <a href="?hero=a">A</a><a href="?hero=b">B</a><a href="?hero=c">C</a><a href="?hero=d">D</a>
  </div>
</section>

<style>
  .pick { position: fixed; left: 16px; bottom: 16px; z-index: 60; display: flex; align-items: center; gap: 6px; padding: 6px 6px 6px 14px; border-radius: 999px; background: rgba(6, 8, 11, 0.85); border: 1px solid var(--hair); font-size: 0.8rem; color: var(--mute); }
  .pick[hidden] { display: none; }
  .pick a { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: var(--ink); font-weight: 700; }
  .pick a[aria-current='true'] { background: var(--accent); color: #fff; }
  .hero { height: 340svh; }
  .hero__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; background: var(--bg); }
  .hero__still, .hero__still img, .hero__gl { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__still img { object-fit: cover; }
  .hero__gl { opacity: 0; transition: opacity 0.6s; }
  .hero.is-gl .hero__gl { opacity: 1; }
  .hero__shade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(6, 8, 11, 0.55) 0%, transparent 22%),
      linear-gradient(0deg, var(--bg) 0%, rgba(6, 8, 11, 0.55) 18%, transparent 46%);
  }
  .hero__copy { position: absolute; left: 0; right: 0; bottom: clamp(2rem, 7vh, 5.625rem); }
  .hero__state { position: relative; }
  .hero__state--b { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 0; }
  .hero__title { font-size: clamp(3rem, 10.5vw, 11.5rem); }
  .hero__lead { margin-top: 1.4rem; max-width: 40ch; color: var(--mute); font-size: clamp(1rem, 1.3vw, 1.2rem); }
  .hero__acts { margin-top: 1.4rem; display: flex; flex-wrap: wrap; gap: 1.2rem 2.2rem; align-items: baseline; font-size: 1.05rem; }
  .hero__cue { margin-top: 1.4rem; }
  .hero__cue span { display: inline-block; animation: nudge 1.8s var(--ease) infinite; }
  @keyframes nudge { 50% { transform: translateY(5px); } }

  :global(.js) .hero__state--b .ln > span { transform: translateY(105%); }
  :global(.js) .hero__state--b .hero__lead, :global(.js) .hero__state--b .hero__acts { opacity: 0; transform: translateY(14px); }

  @media (orientation: portrait) {
    .hero__copy { top: calc(76px + 3vh); bottom: auto; }
    .hero__state--b { top: 0; bottom: auto; }
    .hero__shade {
      background:
        linear-gradient(180deg, var(--bg) 0%, rgba(6, 8, 11, 0.6) 26%, transparent 48%),
        linear-gradient(0deg, var(--bg) 0%, transparent 18%);
    }
  }
  @media (max-width: 760px) {
    .hero__title { font-size: clamp(2.6rem, 13.5vw, 3.6rem); }
    .hero__lead { font-size: 0.97rem; margin-top: 1rem; }
    .hero__acts { margin-top: 1rem; font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero { height: auto; }
    .hero__stage { position: relative; }
    .hero__state--a { display: none; }
    :global(.js) .hero__state--b .ln > span, :global(.js) .hero__state--b .hero__lead, :global(.js) .hero__state--b .hero__acts { transform: none; opacity: 1; }
  }
</style>
